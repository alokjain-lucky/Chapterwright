{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chapterwright/code-snippet",
	"title": "Code Snippet",
	"category": "text",
	"icon": "editor-code",
	"description": "A formatted code example with an optional caption, language label, and copy button, styled to match the Chapterwright reader.",
	"keywords": [ "code", "snippet", "programming", "syntax" ],
	"textdomain": "chapterwright",
	"attributes": {
		"code": {
			"type": "string",
			"default": ""
		},
		"language": {
			"type": "string",
			"default": "php"
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"wrapLines": {
			"type": "boolean",
			"default": false
		},
		"showLineNumbers": {
			"type": "boolean",
			"default": false
		},
		"hideLanguageLabel": {
			"type": "boolean",
			"default": false
		},
		"highlightLines": {
			"type": "string",
			"default": ""
		},
		"startLine": {
			"type": "number",
			"default": 1
		}
	},
	"supports": {
		"html": false,
		"anchor": true
	},
	"editorScript": "file:./edit.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
