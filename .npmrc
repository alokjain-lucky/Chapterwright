# @wordpress/scripts declares an *optional* peer dependency on
# @wordpress/env@^10.0.0 (see its package.json), but this project
# intentionally pins @wordpress/env@^11.5.0 for newer wp-env features.
# npm's default (strict) peer resolution treats that as a hard ERESOLVE
# conflict even though the peer is optional, which breaks `npm ci` in CI
# (see .github/workflows/ci.yml's "Build admin app" and "PHP unit tests"
# jobs). legacy-peer-deps restores npm 6-style behavior — it stops
# treating peer dependency mismatches as fatal — without changing which
# package versions actually get installed.
legacy-peer-deps=true
