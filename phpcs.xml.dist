<?xml version="1.0"?>
<ruleset name="Chapterwright">
	<description>Coding standards for the Chapterwright plugin.</description>

	<file>.</file>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Show progress and use colors. -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Directories and files this ruleset should not touch. -->
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/admin/app/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>

	<!-- Minimum supported PHP version, from the plugin header's "Requires PHP". -->
	<config name="testVersion" value="7.4-"/>

	<!-- Full WordPress-Extra ruleset (coding conventions + a large chunk of
	     WordPress.org plugin-review-style checks), plus WordPress-Docs for
	     docblock formatting, plus PHPCompatibilityWP to flag anything that
	     would not run on the plugin's declared minimum PHP version. -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The plugin's text domain, for WordPress.I18n sniffs (checks every
	     translation function call uses this exact domain — see the 2.1.0
	     i18n work and languages/chapterwright.pot). -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="chapterwright"/>
			</property>
		</properties>
	</rule>

	<!-- hsrtech_* function names are already prefixed consistently; this sniff
	     mainly guards against a stray unprefixed global function/constant
	     being introduced by accident. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hsrtech_"/>
				<element value="HSRTECH_"/>
			</property>
		</properties>
	</rule>

	<!-- Template files (page templates + the code-snippet block's render.php)
	     are loaded by WordPress with their variables already extracted into
	     local scope (via load_template()/get_template_part()-style extract(),
	     or WP_Block::render()'s $attributes/$content/$block context) rather
	     than declared as PHP globals — PrefixAllGlobals doesn't understand
	     that distinction and flags every local variable in these files as an
	     unprefixed global. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/templates/*</exclude-pattern>
		<exclude-pattern>/blocks/*/render.php</exclude-pattern>
	</rule>

	<!-- edit_hsrtech_books and edit_hsrtech_chapters are real custom capabilities
	     registered by hsrtech_add_capabilities_to_roles() (includes/content-types.php)
	     and granted to default roles on activation — not typos of core
	     capabilities. edit_others_hsrtech_books is one of the same capability
	     type's auto-derived plural capabilities (map_meta_cap => true), used
	     in includes/abilities.php to scope the list-books ability to the
	     caller's own books unless they hold it — never granted directly, but
	     still a real, checkable capability string, not a typo. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_hsrtech_books"/>
				<element value="edit_hsrtech_chapters"/>
				<element value="edit_others_hsrtech_books"/>
			</property>
		</properties>
	</rule>

	<!-- WordPress' template hierarchy dictates these exact filenames
	     (single-{post_type}.php / archive-{post_type}.php), and the plugin's
	     post type slugs (hsrtech_book, hsrtech_chapter) contain underscores — the
	     resulting filenames can't be hyphenated without breaking WordPress'
	     template lookup. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/templates/*</exclude-pattern>
	</rule>

	<!-- view.asset.php and edit.asset.php are generated by @wordpress/scripts'
	     webpack build (one per block entry point, named to match the entry)
	     and committed so the block can register its dependencies/version
	     without a build step on activation — the ".asset.php" suffix is
	     fixed by the build tool, not something this plugin's code controls. -->
	<exclude-pattern>/blocks/*/*.asset.php</exclude-pattern>
</ruleset>
